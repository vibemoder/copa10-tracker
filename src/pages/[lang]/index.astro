                            <span class="text-[10px] md:text-xs text-zinc-600 mb-1 font-black uppercase tracking-widest">{t('stats.collectors')}</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12 bg-zinc-900/20 p-6 rounded-[2.5rem] border border-zinc-800/30">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-zinc-800 rounded-full flex items-center justify-center">
                            <span class="text-xl">🏆</span>
                        </div>
                        <div>
                            <p class="text-white font-bold text-sm">{t('welcome.share_title')}</p>
                            <p class="text-zinc-500 text-xs">Unlock lifetime premium by inviting 5 friends.</p>
                        </div>
                    </div>
                    <ShareButton 
                        client:load 
                        userId={userId!} 
                        lang={lang} 
                        shareTitle={t('referral.share_button')} 
                        shareText={t('referral.share_text')} 
                    />
                </div>

                {nearbyCollectors.length > 0 && (
                    <div class="bg-gradient-to-r from-zinc-900/80 via-[#e3b341]/5 to-zinc-900/80 backdrop-blur-md border border-zinc-800 p-5 rounded-3xl mb-12 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl relative overflow-hidden group">
                        <div class="absolute inset-y-0 left-0 w-1.5 bg-green-500 shadow-[0_0_20px_rgba(34,197,94,1)] animate-pulse" />
                        <div class="flex items-center gap-5">
                            <div class="w-12 h-12 bg-green-500/10 rounded-2xl flex items-center justify-center border border-green-500/20 rotate-3 group-hover:rotate-0 transition-transform">
                                <div class="w-4 h-4 bg-green-500 rounded-full animate-ping" />
                            </div>
                            <span class="text-sm md:text-lg text-zinc-200 font-bold tracking-tight">
                               <Fragment set:html={t('banner.nearby').replace('{count}', nearbyCollectors.length.toString()).replace('{city}', nearbyCollectors[0].city || 'your area')} />
                            </span>
                        </div>
                        <button class="bg-zinc-950 px-8 py-3 rounded-full text-xs text-[#e3b341] font-black border border-[#e3b341]/40 hover:bg-[#e3b341] hover:text-zinc-950 transition-all uppercase tracking-[0.2em] shadow-xl transform group-hover:scale-105">
                            {t('banner.tradehub')}
                        </button>
                    </div>
                )}

                <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-8">
                    <div class="relative">
                        <h2 class="text-4xl md:text-6xl font-black text-white uppercase tracking-tighter italic leading-none drop-shadow-lg">{t('album.title')}</h2>
                        <p class="text-xs md:text-lg text-zinc-500 font-bold tracking-wide mt-2 flex items-center gap-2">
                            <span class="w-2 h-2 bg-[#e3b341] rounded-full" />
                            {t('album.subtitle')}
                        </p>
                    </div>
                    <div class="flex gap-3 overflow-x-auto pb-6 w-full md:w-auto -mx-4 px-4 md:mx-0 md:px-0 no-scrollbar">
                        <button class="bg-[#e3b341] text-zinc-950 px-7 py-3 rounded-sm text-[10px] md:text-xs font-black uppercase tracking-[0.2em] hover:bg-white transition-all transform skew-x-[-12deg] shadow-xl shadow-[#e3b341]/10">
                            <span class="block skew-x-[12deg]">{t('filter.all')}</span>
                        </button>
                        {nations.slice(0, 5).map(nation => (
                            <button class="bg-zinc-900/60 text-zinc-400 px-7 py-3 rounded-sm text-[10px] md:text-xs font-black uppercase tracking-[0.2em] hover:bg-zinc-800 transition-all transform skew-x-[-12deg] border border-zinc-800/50 backdrop-blur-sm">
                                <span class="block skew-x-[12deg]">{nation}</span>
                            </button>
                        ))}
                        <button class="bg-zinc-900/30 text-zinc-600 px-7 py-3 rounded-sm text-[10px] md:text-xs font-black uppercase tracking-[0.2em] border border-zinc-800/50 border-dashed transform skew-x-[-12deg]">
                             <span class="block skew-x-[12deg]">{t('filter.more')}</span>
                        </button>
                    </div>
                </div>

                {nations.map((nation) => (
                    <div class="mb-20">
                        {/* Parallax Stylized Header */}
                        <div class="sticky top-20 z-30 py-6 mb-10 overflow-hidden group">
                            <div class={`absolute inset-0 bg-gradient-to-r ${getNationGradient(nation)} opacity-20 blur-2xl transform scale-150 group-hover:scale-110 transition-transform duration-1000`} />
                            <div class="flex items-center gap-8 relative">
                                <div class={`h-1.5 w-24 bg-gradient-to-r ${getNationGradient(nation)} rounded-full shadow-[0_0_15px_rgba(255,255,255,0.2)]`} />
                                <h3 class="text-3xl md:text-6xl font-black text-white uppercase italic tracking-tighter drop-shadow-[0_5px_15px_rgba(0,0,0,0.5)] transform -skew-x-12">
                                    {nation}
                                </h3>
                                <div class="flex-grow h-[2px] bg-white/10" />
                                <div class="bg-zinc-900/80 backdrop-blur-md px-6 py-2 rounded-full border border-white/10 shadow-2xl">
                                    <span class="text-[10px] md:text-xs text-white font-black uppercase tracking-[0.3em]">{groups[nation].length} items</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-x-4 gap-y-16">
                            {groups[nation].map((sticker: any) => (
                                <StickerCard 
                                    client:visible 
                                    sticker={sticker} 
                                    initialQty={userCollection[sticker.id] || 0} 
                                    isLoggedIn={!!userId} 
                                    lang={lang}
                                />
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        )}
	</section>
</Layout>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .perspective {
        perspective: 1000px;
    }
</style>
