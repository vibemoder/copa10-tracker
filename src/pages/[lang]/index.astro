                        </div>
                    </div>

                    {/* Nearby Tile */}
                    <div class="bg-zinc-900/40 backdrop-blur-xl border border-zinc-800/50 p-5 md:p-7 rounded-[2rem] shadow-2xl group hover:border-green-500/20 transition-all cursor-default">
                        <span class="text-[10px] md:text-xs text-zinc-500 uppercase tracking-[0.25em] font-black">{t('stats.nearby')}</span>
                        <div class="flex items-end gap-1 md:gap-2 mt-3">
