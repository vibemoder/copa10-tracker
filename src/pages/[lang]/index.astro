---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../db';
import { stickers, collection, profiles } from '../../db/schema';
import { asc, eq, and } from 'drizzle-orm';
import { syncUser } from '../../db/utils';
import StickerCard from '../../components/StickerCard';
import ShareButton from '../../components/ShareButton';
import FIFAHero from '../../components/FIFAHero';
import fallbackStickers from '../../scripts/stickers_seed.json';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { SignInButton } from '@clerk/astro/components';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Handle Referrals
const utmSource = Astro.url.searchParams.get('utm_source');
if (utmSource && !Astro.cookies.has('referral_id')) {
    Astro.cookies.set('referral_id', utmSource, { path: '/', httpOnly: true, maxAge: 60 * 60 * 24 * 7 }); // 1 week
}

const auth = Astro.locals.auth?.();
const userId = auth?.userId;
let userEmail = '';

if (userId) {
    try {
        const user = await Astro.locals.currentUser();
        userEmail = user?.emailAddresses[0]?.emailAddress || '';
        if (userEmail) {
            const referralId = Astro.cookies.get('referral_id')?.value;
            await syncUser(userId, userEmail, referralId);
        }
    } catch (e) {
        console.warn('User sync failed, probably no DB');
    }
}

// Fetch stickers from the database
let stickerData = [];
let userCollection: Record<number, number> = {};
let dbError = false;

try {
    stickerData = await db.select().from(stickers).orderBy(asc(stickers.id));
    
    if (userId) {
        const userStickers = await db.select().from(collection).where(eq(collection.userId, userId));
        userCollection = userStickers.reduce((acc, row) => {
            acc[row.stickerId] = row.qty;
            return acc;
        }, {} as Record<number, number>);
    }
} catch (error: any) {
    console.warn('DB connection failed, using fallback JSON data.', error?.message);
    stickerData = fallbackStickers;
    dbError = true;
}

// Group stickers by nation for the "Combined View"
const groups = stickerData.reduce((acc: any, sticker) => {
  const key = sticker.nation || 'Special';
  if (!acc[key]) acc[key] = [];
  acc[key].push(sticker);
  return acc;
}, {});

const nations = Object.keys(groups).sort((a, b) => {
    if (a === 'Special') return -1;
    if (b === 'Special') return 1;
    return a.localeCompare(b);
});

// Progress Stats
const totalStickers = stickerData.length;
const ownedCount = Object.values(userCollection).filter(qty => qty > 0).length;
const missingCount = totalStickers - ownedCount;
const percentOwned = totalStickers > 0 ? Math.round((ownedCount / totalStickers) * 100) : 0;
const totalDuplicates = Object.values(userCollection).reduce((acc, qty) => acc + Math.max(0, qty - 1), 0);

// Fetch Nearby Collectors (Anonymous)
let nearbyCollectors: any[] = [];
if (userId && !dbError) {
    const userProfile = await db.query.profiles.findFirst({
        where: eq(profiles.id, userId)
    });
    
    if (userProfile?.lat && userProfile?.lng) {
        nearbyCollectors = await db.select({
            id: profiles.id,
            city: profiles.city,
        })
        .from(profiles)
        .where(
            and(
                eq(profiles.lat, userProfile.lat),
                eq(profiles.lng, userProfile.lng),
            )
        )
        .limit(10);
    }
}

// Color Mapping for Nations (FIFA inspired)
const nationColors: Record<string, string> = {
    'Brazil': 'from-[#009739] via-[#fedd00] to-[#009739]',
    'Argentina': 'from-[#74acdf] via-white to-[#74acdf]',
    'France': 'from-[#002395] via-white to-[#ed2939]',
    'Germany': 'from-black via-white to-[#ffce00]',
    'Spain': 'from-[#aa151b] via-[#f1bf00] to-[#aa151b]',
    'Italy': 'from-[#008c45] via-white to-[#cd212a]',
    'England': 'from-white via-[#ce1124] to-white',
    'Portugal': 'from-[#red-700] via-[#006600] to-[#ed2939]',
    'Uruguay': 'from-[#0081c8] via-white to-[#0081c8]',
    'Mexico': 'from-[#006847] via-white to-[#ce1124]',
    'USA': 'from-[#3c3b6e] via-white to-[#b22234]',
    'United States': 'from-[#3c3b6e] via-white to-[#b22234]',
    'Canada': 'from-[#ff0000] via-white to-[#ff0000]',
    'Netherlands': 'from-[#f36c21] via-white to-[#21468b]',
    'Belgium': 'from-[#ef3340] via-[#ffd100] to-black',
    'Croatia': 'from-[#ff0000] via-white to-[#0000ff]',
    'Colombia': 'from-[#fcd116] via-[#003893] to-[#ce1124]',
    'Morocco': 'from-[#c1272d] via-[#006233] to-[#c1272d]',
    'Japan': 'from-[#00008b] via-white to-[#00008b]',
    'South Korea': 'from-[#ff0000] via-[#000000] to-[#0000ff]',
    'Senegal': 'from-[#00853f] via-[#fdef42] to-[#e31b23]',
    'Switzerland': 'from-[#ff0000] via-white to-[#ff0000]',
    'Ecuador': 'from-[#ffdd00] via-[#034ea2] to-[#ed1c24]',
    'Ghana': 'from-[#ff0000] via-[#fdef42] to-[#006b3f]',
    'Australia': 'from-[#00008b] via-[#ffcd00] to-[#008a00]',
    'Paraguay': 'from-[#d52b1e] via-white to-[#0038a8]',
    'Sweden': 'from-[#006aa7] via-[#fecc00] to-[#006aa7]',
    'Norway': 'from-[#ba0c2f] via-[#00205b] to-[#ba0c2f]',
    'Austria': 'from-[#ed2939] via-white to-[#ed2939]',
    'Turkey': 'from-[#e30a17] via-white to-[#e30a17]',
    'Egypt': 'from-[#ce1126] via-white to-black',
    'Saudi Arabia': 'from-[#006c35] via-white to-[#006c35]',
    'Qatar': 'from-[#8d1b3d] via-white to-[#8d1b3d]',
    'Panama': 'from-[#da121a] via-white to-[#072344]',
    'Special': 'from-[#e3b341] via-[#fff5a5] to-[#c49000]',
};

const getNationGradient = (nation: string) => nationColors[nation] || 'from-zinc-700 via-zinc-800 to-zinc-900';
---

<Layout title={`${t('nav.title')} - ${t('album.title')}`}>
	<section class="py-4 md:py-8 min-h-screen bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-zinc-900 via-black to-black perspective">
        {!userId ? (
            <div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-4 relative overflow-hidden">
                <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[100%] bg-[#e3b341]/5 blur-[120px] rotate-45 pointer-events-none" />
                <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[100%] bg-blue-500/5 blur-[120px] -rotate-45 pointer-events-none" />

                <div class="w-24 h-24 bg-[#e3b341] rounded-3xl flex items-center justify-center mb-8 shadow-[0_0_50px_rgba(227,179,65,0.4)] transform hover:rotate-12 transition-transform cursor-default">
                    <span class="text-5xl font-black text-zinc-950 italic">10</span>
                </div>
                
                <h2 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tighter uppercase italic drop-shadow-2xl">
