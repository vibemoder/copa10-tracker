---
import Layout from '../layouts/Layout.astro';
import stickerData from '../scripts/stickers_seed.json';

// Group stickers by nation for the "Combined View"
const groups = stickerData.reduce((acc: any, sticker) => {
  const key = sticker.nation || 'Special';
  if (!acc[key]) acc[key] = [];
  acc[key].push(sticker);
  return acc;
}, {});

const nations = Object.keys(groups).sort((a, b) => {
    if (a === 'Special') return -1;
    if (b === 'Special') return 1;
    return a.localeCompare(b);
});
---

<Layout title="Copa10 - Sticker Tracker">
	<section class="py-8">
		<div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
            <div>
                <h2 class="text-3xl font-bold text-white">Your Album</h2>
                <p class="text-zinc-400">Track 980 stickers across all teams.</p>
            </div>
            <div class="flex gap-2 overflow-x-auto pb-2 w-full md:w-auto">
                <button class="bg-zinc-800 px-4 py-2 rounded-full text-sm font-medium hover:bg-zinc-700 whitespace-nowrap border border-zinc-700">All Stickers</button>
                {nations.slice(0, 5).map(nation => (
                    <button class="bg-zinc-900 px-4 py-2 rounded-full text-sm font-medium hover:bg-zinc-800 whitespace-nowrap border border-zinc-800 text-zinc-400">{nation}</button>
                ))}
                <button class="bg-zinc-900 px-4 py-2 rounded-full text-sm font-medium hover:bg-zinc-800 whitespace-nowrap border border-zinc-800 text-zinc-400">More Teams...</button>
            </div>
        </div>

        {nations.map((nation) => (
            <div class="mb-12">
                <div class="flex items-center gap-4 mb-6 border-b border-zinc-800 pb-2">
                    <h3 class="text-xl font-bold text-[#e3b341] uppercase tracking-widest">{nation}</h3>
                    <span class="text-xs text-zinc-500 font-mono">{groups[nation].length} stickers</span>
                </div>
                
                <div class="grid grid-cols-3 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-3">
                    {groups[nation].map((sticker: any) => (
                        <div class="bg-zinc-900 border border-zinc-800 p-2 rounded flex flex-col items-center hover:border-zinc-600 transition-all cursor-pointer group relative overflow-hidden">
                            {/* Duplicate Indicator Placeholder */}
                            <div class="absolute top-0 right-0 bg-blue-600 text-[8px] font-bold px-1.5 py-0.5 rounded-bl opacity-0 group-hover:opacity-100 transition-opacity">
                                DUP
                            </div>
                            
                            <span class="text-[10px] text-zinc-500 font-mono mb-1">{sticker.code}</span>
                            <div class="w-full aspect-[3/4] bg-zinc-800 rounded flex items-center justify-center text-zinc-700 font-bold text-lg mb-1 group-hover:bg-zinc-700 group-hover:text-zinc-400 transition-colors">
                                {sticker.id}
                            </div>
                            <span class="text-[10px] text-zinc-400 text-center line-clamp-1 w-full">{sticker.name}</span>
                        </div>
                    ))}
                </div>
            </div>
        ))}
	</section>
</Layout>
