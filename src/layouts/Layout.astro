---
import '../styles/global.css'
import { UserButton, SignInButton } from '@clerk/astro/components';
import LocationSync from '../components/LocationSync';

interface Props {
	title: string;
}

const { title } = Astro.props;
const auth = Astro.locals.auth?.();
const userId = auth?.userId;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen">
        <LocationSync client:load isLoggedIn={!!userId} />
		<header class="border-b border-zinc-800 p-4 flex justify-between items-center max-w-7xl mx-auto w-full">
			<h1 class="text-xl font-bold text-[#e3b341]">Copa10 Sticker Tracker</h1>
			<nav>
				{userId ? (
					<UserButton />
				) : (
					<SignInButton mode="modal" class="bg-[#e3b341] text-zinc-950 px-4 py-2 rounded font-bold hover:bg-[#d4a230] transition-colors" />
				)}
			</nav>
		</header>
		<main class="max-w-7xl mx-auto p-4">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--primary: #e3b341;
	}
</style>
