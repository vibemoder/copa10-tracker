---
import '../styles/global.css'
import { UserButton, SignInButton } from '@clerk/astro/components';
import LocationSync from '../components/LocationSync';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
}

const { title } = Astro.props;
const auth = Astro.locals.auth?.();
const userId = auth?.userId;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const description = t('seo.description');
const siteUrl = 'https://copa10tracker.vercel.app';
const ogImage = `${siteUrl}/og-image.png`; // Fallback to a future image
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        
        <meta name="description" content={description} />
        
        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={ogImage} />

        <meta name="theme-color" content="#09090b" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen overflow-x-hidden">
        <LocationSync client:load isLoggedIn={!!userId} />
		<header class="border-b border-zinc-800 p-4 sticky top-0 bg-zinc-950/80 backdrop-blur-md z-50">
            <div class="max-w-7xl mx-auto flex justify-between items-center w-full">
                <h1 class="text-xl md:text-2xl font-black text-[#e3b341] tracking-tighter italic animate-title">
                    {t('nav.title')}
                </h1>
                <nav class="flex items-center gap-4">
                    <div class="hidden md:flex gap-2 text-xs font-bold">
                        <a href="/pt" class={lang === 'pt' ? 'text-[#e3b341]' : 'text-zinc-500 hover:text-zinc-300'}>PT</a>
                        <a href="/en" class={lang === 'en' ? 'text-[#e3b341]' : 'text-zinc-500 hover:text-zinc-300'}>EN</a>
                        <a href="/es" class={lang === 'es' ? 'text-[#e3b341]' : 'text-zinc-500 hover:text-zinc-300'}>ES</a>
                    </div>
                    {userId && <UserButton />}
                </nav>
            </div>
		</header>
		<main class="max-w-7xl mx-auto p-4">
			<slot />
		</main>

        <footer class="border-t border-zinc-900 bg-black py-12 px-6 mt-20">
            <div class="max-w-7xl mx-auto flex flex-col items-center text-center">
                <div class="w-12 h-12 bg-[#e3b341] rounded-2xl flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(227,179,65,0.2)] transform -rotate-12">
                    <span class="text-2xl font-black text-zinc-950 italic">10</span>
                </div>

                <div class="max-w-2xl mb-8">
                    <p class="text-[10px] text-zinc-600 font-medium italic leading-relaxed uppercase tracking-wider">
                        This app is made by a solo-preneur, passionate about sports and collections. 
                        This app is not endorsed or affiliated with any of the brands that distribute and otherwise made available the Stickers ("Figurinhas") or Cards ("Cartas").
                    </p>
                    <p class="text-[10px] text-zinc-500 mt-4 font-bold uppercase tracking-[0.2em]">
                        Developed and maintained by <a href="https://imbriani.dev" target="_blank" class="text-zinc-400 hover:text-[#e3b341] underline transition-colors">Carlos Alberto Kümpel Imbriani</a>
                    </p>
                </div>

                <div class="bg-zinc-900/30 backdrop-blur-sm border border-zinc-800/50 rounded-2xl p-6 max-w-3xl w-full">
                    <p class="text-[10px] text-zinc-500 font-black uppercase tracking-[0.3em] mb-4">Powered by & special thanks to</p>
                    <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-500">
                        <span class="text-[10px] text-white font-bold flex items-center gap-1.5 cursor-default">
                            <div class="w-1 h-1 bg-blue-500 rounded-full"></div> WIKIPEDIA
                        </span>
                        <span class="text-[10px] text-white font-bold flex items-center gap-1.5 cursor-default">
                            <div class="w-1 h-1 bg-red-500 rounded-full"></div> FLAGCDN
                        </span>
                        <span class="text-[10px] text-white font-bold flex items-center gap-1.5 cursor-default">
                            <div class="w-1 h-1 bg-green-500 rounded-full"></div> NEON DB
                        </span>
                        <span class="text-[10px] text-white font-bold flex items-center gap-1.5 cursor-default">
                            <div class="w-1 h-1 bg-white rounded-full"></div> VERCEL
                        </span>
                        <span class="text-[10px] text-white font-bold flex items-center gap-1.5 cursor-default">
                            <div class="w-1 h-1 bg-[#6C47FF] rounded-full"></div> CLERK
                        </span>
                        <span class="text-[10px] text-white font-bold flex items-center gap-1.5 cursor-default">
                            <div class="w-1 h-1 bg-[#4285F4] rounded-full"></div> GOOGLE
                        </span>
                    </div>
                </div>

                {!userId && (
                    <SignInButton mode="modal" class="mt-8 text-[10px] text-zinc-600 hover:text-[#e3b341] uppercase tracking-[0.2em] transition-colors cursor-pointer">
                        {t('nav.signin')}
                    </SignInButton>
                )}

                <p class="mt-10 text-[9px] text-zinc-800 font-black uppercase tracking-[0.5em]">
                    &copy; {new Date().getFullYear()} Copa10
                </p>
            </div>
        </footer>
	</body>
</html>

<style is:global>
	:root {
		--primary: #e3b341;
	}

    @keyframes title-glow {
        0%, 100% {
            text-shadow: 0 0 10px rgba(227, 179, 65, 0.2);
            transform: translateY(0) skewX(-12deg);
        }
        50% {
            text-shadow: 0 0 25px rgba(227, 179, 65, 0.5);
            transform: translateY(-2px) skewX(-12deg);
        }
    }

    .animate-title {
        animation: title-glow 4s ease-in-out infinite;
        display: inline-block;
    }
</style>
