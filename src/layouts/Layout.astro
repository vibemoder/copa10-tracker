---
import '../styles/global.css'
import { UserButton, SignInButton } from '@clerk/astro/components';
import LocationSync from '../components/LocationSync';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	title: string;
}

const { title } = Astro.props;
const auth = Astro.locals.auth?.();
const userId = auth?.userId;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen overflow-x-hidden">
        <LocationSync client:load isLoggedIn={!!userId} />
		<header class="border-b border-zinc-800 p-4 sticky top-0 bg-zinc-950/80 backdrop-blur-md z-50">
            <div class="max-w-7xl mx-auto flex justify-between items-center w-full">
                <h1 class="text-lg md:text-xl font-bold text-[#e3b341]">{t('nav.title')}</h1>
                <nav class="flex items-center gap-4">
                    <div class="hidden md:flex gap-2 text-xs font-bold">
                        <a href="/pt" class={lang === 'pt' ? 'text-[#e3b341]' : 'text-zinc-500 hover:text-zinc-300'}>PT</a>
                        <a href="/en" class={lang === 'en' ? 'text-[#e3b341]' : 'text-zinc-500 hover:text-zinc-300'}>EN</a>
                        <a href="/es" class={lang === 'es' ? 'text-[#e3b341]' : 'text-zinc-500 hover:text-zinc-300'}>ES</a>
                    </div>
                    {userId ? (
                        <UserButton />
                    ) : (
                        <SignInButton mode="modal" class="bg-[#e3b341] text-zinc-950 px-3 py-1.5 md:px-4 md:py-2 rounded text-sm font-bold hover:bg-[#d4a230] transition-colors">
                            {t('nav.signin')}
                        </SignInButton>
                    )}
                </nav>
            </div>
		</header>
		<main class="max-w-7xl mx-auto p-4">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	:root {
		--primary: #e3b341;
	}
</style>
